      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "abstract-create-app",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityResourceId'))]": {}
        }
      },
      "properties": {
        "azCliVersion": "[parameters('azCliVersion')]",
        "retentionInterval": "PT1H",
        "cleanupPreference": "OnSuccess",
        "timeout": "PT30M",
        "environmentVariables": [
          {
            "name": "APP_NAME",
            "value": "[parameters('appDisplayName')]"
          },
          {
            "name": "KV_NAME",
            "value": "[variables('effectiveKeyVaultName')]"
          },
          {
            "name": "VAULT_URI",
            "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName')), '2023-07-01').vaultUri]"
          },
          {
            "name": "SECRET_NAME",
            "value": "[variables('secretName')]"
          },
          {
            "name": "SECRET_YEARS",
            "value": "[string(parameters('secretValidityYears'))]"
          }
        ],
        "scriptContent": "set -euo pipefail\n# Reuse an existing app of the same display name, else create it (single-tenant).\nappId=$(az ad app list --display-name \"$APP_NAME\" --query '[0].appId' -o tsv)\nif [ -z \"$appId\" ] || [ \"$appId\" = \"None\" ]; then\n  appId=$(az ad app create --display-name \"$APP_NAME\" --sign-in-audience AzureADMyOrg --query appId -o tsv)\nfi\n# Service principal (idempotent).\nspId=$(az ad sp show --id \"$appId\" --query id -o tsv 2>/dev/null || true)\nif [ -z \"$spId\" ] || [ \"$spId\" = \"None\" ]; then\n  spId=$(az ad sp create --id \"$appId\" --query id -o tsv)\n  sleep 20   # allow directory replication before downstream role assignment\nfi\n# Client secret -> Key Vault only (never emitted as an output).\nsecret=$(az ad app credential reset --id \"$appId\" --append --display-name \"$SECRET_NAME\" --years \"$SECRET_YEARS\" --query password -o tsv)\naz keyvault secret set --vault-name \"$KV_NAME\" --name \"$SECRET_NAME\" --value \"$secret\" -o none\ntenantId=$(az account show --query tenantId -o tsv)\nkvUri=\"${VAULT_URI}secrets/${SECRET_NAME}\"\necho \"{\\\"appId\\\":\\\"$appId\\\",\\\"spObjectId\\\":\\\"$spId\\\",\\\"tenantId\\\":\\\"$tenantId\\\",\\\"keyVaultSecretUri\\\":\\\"$kvUri\\\"}\" > \"$AZ_SCRIPTS_OUTPUT_PATH\"\n"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName'))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName')), parameters('managedIdentityResourceId'), variables('keyVaultSecretsOfficerRoleId')))]"
      ]
    },
    {
      "condition": "[parameters('createWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('effectiveWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "[parameters('workspaceSku')]"
        },
        "retentionInDays": "[parameters('workspaceRetentionDays')]",
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "condition": "[and(parameters('createWorkspace'), parameters('enableSentinel'))]",
      "type": "Microsoft.SecurityInsights/onboardingStates",
      "apiVersion": "2024-03-01",
      "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]",
      "name": "default",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[format('{0}/{1}', variables('effectiveWorkspaceName'), parameters('customTableName'))]",
      "properties": {
        "schema": {
          "copy": [
            {
              "name": "columns",
              "count": "[length(parameters('tableColumns'))]",
              "input": {
                "name": "[parameters('tableColumns')[copyIndex('columns')].name]",
                "type": "[if(equals(toLower(string(parameters('tableColumns')[copyIndex('columns')].type)), 'datetime'), 'dateTime', toLower(string(parameters('tableColumns')[copyIndex('columns')].type)))]"
              }
            }
          ],
          "name": "[parameters('customTableName')]"
        },
        "totalRetentionInDays": "[parameters('workspaceRetentionDays')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionEndpointName')]",
      "location": "[variables('effectiveLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2023-03-11",
      "name": "[parameters('dataCollectionRuleName')]",
      "location": "[variables('effectiveLocation')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "streamDeclarations": {
          "[format('{0}', variables('streamName'))]": {
            "copy": [
              {
                "name": "columns",
                "count": "[length(parameters('tableColumns'))]",
                "input": {
                  "name": "[parameters('tableColumns')[copyIndex('columns')].name]",
                  "type": "[toLower(string(parameters('tableColumns')[copyIndex('columns')].type))]"
                }
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[variables('workspaceResourceId')]",
              "name": "[variables('logAnalyticsDestinationName')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[variables('streamName')]"
            ],
            "destinations": [
              "[variables('logAnalyticsDestinationName')]"
            ],
            "transformKql": "source",
            "outputStream": "[variables('streamName')]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', split(format('{0}/{1}', variables('effectiveWorkspaceName'), parameters('customTableName')), '/')[0], split(format('{0}/{1}', variables('effectiveWorkspaceName'), parameters('customTableName')), '/')[1])]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), 'abstract-app-metrics-publisher', variables('monitoringMetricsPublisherRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Resources/deploymentScripts', 'abstract-create-app'), '2023-08-01').outputs.spObjectId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringMetricsPublisherRoleId'))]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deploymentScripts', 'abstract-create-app')]",
        "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), 'abstract-app-monitoring-contributor', variables('monitoringContributorRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Resources/deploymentScripts', 'abstract-create-app'), '2023-08-01').outputs.spObjectId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringContributorRoleId'))]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deploymentScripts', 'abstract-create-app')]",
        "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]"
