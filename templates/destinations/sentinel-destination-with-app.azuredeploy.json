      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName')), '2023-03-11').logsIngestion.endpoint]"
    },
    "logStreamName": {
      "type": "string",
      "value": "[variables('streamName')]"
    },
    "abstractModalHint": {
      "type": "string",
      "value": "[format('Client Secret Value = read secret \"{0}\" from Key Vault \"{1}\"; all other fields are in the outputs above.', variables('secretName'), variables('effectiveKeyVaultName'))]"
    }
  }
}