        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName')), parameters('managedIdentityResourceId'), variables('keyVaultSecretsOfficerRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', last(split(parameters('managedIdentityResourceId'), '/'))), '2023-01-31').principalId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsOfficerRoleId'))]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('secretReaderObjectId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('effectiveKeyVaultName')), parameters('secretReaderObjectId'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "principalId": "[parameters('secretReaderObjectId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]"
