    "autoWorkspaceName": "[format('abstract-sentinel-{0}', uniqueString(resourceGroup().id))]",
    "effectiveWorkspaceName": "[if(parameters('createWorkspace'), if(empty(parameters('workspaceName')), variables('autoWorkspaceName'), parameters('workspaceName')), parameters('workspaceName'))]",
    "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]",
    "effectiveLocation": "[if(parameters('createWorkspace'), parameters('location'), if(empty(parameters('existingWorkspaceLocation')), parameters('location'), parameters('existingWorkspaceLocation')))]",
    "generatedSchema": "[variables('$fxv#0')]",
    "useGeneratedSchema": "[empty(parameters('tableColumns'))]",
    "effectiveTableColumns": "[if(variables('useGeneratedSchema'), variables('generatedSchema').tableColumns, parameters('tableColumns'))]",
    "effectiveStreamColumns": "[if(variables('useGeneratedSchema'), variables('generatedSchema').streamColumns, parameters('tableColumns'))]",
    "effectiveTransformKql": "[if(variables('useGeneratedSchema'), variables('generatedSchema').transformKql, parameters('transformKql'))]",
    "sourceRouteCatalog": "[variables('$fxv#1').routes]",
    "enabledSourceRoutes": "[filter(variables('sourceRouteCatalog'), lambda('route', contains(parameters('sourceRoutes'), lambdaVariables('route').name)))]",
    "sourceRouteTables": "[filter(variables('enabledSourceRoutes'), lambda('route', contains(lambdaVariables('route'), 'table')))]",
    "streamName": "[format('Custom-{0}', parameters('customTableName'))]",
    "logAnalyticsDestinationName": "abstractSentinelWorkspace",
    "monitoringMetricsPublisherRoleId": "3913510d-42f4-4e42-8a64-420c390055eb",
    "monitoringContributorRoleId": "749f88d5-cbae-40b8-bcfc-e573ddc772fa"
  },
  "resources": [
    {
      "condition": "[parameters('createWorkspace')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2026-03-01",
      "name": "[variables('effectiveWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), if(contains(parameters('tagsByResource'), 'Microsoft.OperationalInsights/workspaces'), parameters('tagsByResource')['Microsoft.OperationalInsights/workspaces'], createObject()))]",
      "properties": {
        "sku": {
          "name": "[parameters('workspaceSku')]"
        },
        "retentionInDays": "[parameters('workspaceRetentionDays')]",
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "condition": "[and(parameters('createWorkspace'), parameters('enableSentinel'))]",
      "type": "Microsoft.SecurityInsights/onboardingStates",
      "apiVersion": "2024-03-01",
      "scope": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]",
      "name": "default",
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2026-03-01",
      "name": "[format('{0}/{1}', variables('effectiveWorkspaceName'), parameters('customTableName'))]",
      "properties": {
        "schema": {
          "copy": [
            {
              "name": "columns",
              "count": "[length(variables('effectiveTableColumns'))]",
              "input": {
                "name": "[variables('effectiveTableColumns')[copyIndex('columns')].name]",
                "type": "[if(equals(toLower(string(variables('effectiveTableColumns')[copyIndex('columns')].type)), 'datetime'), 'dateTime', toLower(string(variables('effectiveTableColumns')[copyIndex('columns')].type)))]"
              }
            }
          ],
          "name": "[parameters('customTableName')]"
        },
        "totalRetentionInDays": "[parameters('workspaceRetentionDays')]",
        "plan": "[parameters('customTablePlan')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2024-03-11",
      "name": "[parameters('dataCollectionEndpointName')]",
      "location": "[variables('effectiveLocation')]",
      "tags": "[union(parameters('tags'), if(contains(parameters('tagsByResource'), 'Microsoft.Insights/dataCollectionEndpoints'), parameters('tagsByResource')['Microsoft.Insights/dataCollectionEndpoints'], createObject()))]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "copy": {
        "name": "sourceRouteTable",
        "count": "[length(variables('sourceRouteTables'))]"
      },
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2026-03-01",
      "name": "[format('{0}/{1}', variables('effectiveWorkspaceName'), variables('sourceRouteTables')[copyIndex()].table.name)]",
      "properties": {
        "schema": {
          "name": "[variables('sourceRouteTables')[copyIndex()].table.name]",
          "columns": "[variables('sourceRouteTables')[copyIndex()].table.columns]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('effectiveWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2024-03-11",
      "name": "[parameters('dataCollectionRuleName')]",
      "location": "[variables('effectiveLocation')]",
      "tags": "[union(parameters('tags'), if(contains(parameters('tagsByResource'), 'Microsoft.Insights/dataCollectionRules'), parameters('tagsByResource')['Microsoft.Insights/dataCollectionRules'], createObject()))]",
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "streamDeclarations": {
          "[format('{0}', variables('streamName'))]": {
            "copy": [
              {
                "name": "columns",
                "count": "[length(variables('effectiveStreamColumns'))]",
                "input": {
                  "name": "[variables('effectiveStreamColumns')[copyIndex('columns')].name]",
                  "type": "[toLower(string(variables('effectiveStreamColumns')[copyIndex('columns')].type))]"
                }
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[variables('workspaceResourceId')]",
              "name": "[variables('logAnalyticsDestinationName')]"
            }
          ]
        },
        "dataFlows": "[concat(createArray(createObject('streams', createArray(variables('streamName')), 'destinations', createArray(variables('logAnalyticsDestinationName')), 'transformKql', variables('effectiveTransformKql'), 'outputStream', variables('streamName'))), variables('sourceRouteFlows'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', split(format('{0}/{1}', variables('effectiveWorkspaceName'), parameters('customTableName')), '/')[0], split(format('{0}/{1}', variables('effectiveWorkspaceName'), parameters('customTableName')), '/')[1])]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName'))]",
        "sourceRouteTable"
      ]
    },
    {
      "condition": "[parameters('enableDcrErrorLogs')]",
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]",
      "name": "abstract-dcr-errors",
      "properties": {
        "workspaceId": "[variables('workspaceResourceId')]",
        "logs": [
          {
            "category": "LogErrors",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('principalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), parameters('principalId'), variables('monitoringMetricsPublisherRoleId'))]",
      "properties": {
        "principalId": "[parameters('principalId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringMetricsPublisherRoleId'))]",
        "principalType": "[parameters('principalType')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('principalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]",
      "name": "[guid(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), parameters('principalId'), variables('monitoringContributorRoleId'))]",
      "properties": {
        "principalId": "[parameters('principalId')]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('monitoringContributorRoleId'))]",
        "principalType": "[parameters('principalType')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName'))]"
      ]
    }
  ],
  "outputs": {
    "workspaceName": {
      "type": "string",
      "value": "[variables('effectiveWorkspaceName')]"
    },
    "workspaceResourceId": {
      "type": "string",
      "value": "[variables('workspaceResourceId')]"
    },
    "customTableName": {
      "type": "string",
      "value": "[parameters('customTableName')]"
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), '2024-03-11').immutableId]"
    },
    "dataCollectionEndpointUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName')), '2024-03-11').logsIngestion.endpoint]"
    },
    "logStreamName": {
      "type": "string",
      "value": "[variables('streamName')]"
    },
    "rbacAssigned": {
      "type": "bool",
      "value": "[not(empty(parameters('principalId')))]"
    },
    "abstractSentinelOnboarding": {
      "type": "object",
      "value": {
        "azureMonitorDetails": {
          "dataCollectionRuleId": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dataCollectionRuleName')), '2024-03-11').immutableId]",
          "dataCollectionEndpoint": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dataCollectionEndpointName')), '2024-03-11').logsIngestion.endpoint]",
          "logStreamName": "[variables('streamName')]"
        },
        "authentication": {
          "clientId": "(Entra ID > App registrations > your app > Application (client) ID)",
          "clientSecretValue": "(Entra ID > App registrations > your app > Certificates & secrets)",
          "applicationTenantId": "[subscription().tenantId]"
        },
        "rbac": "[if(not(empty(parameters('principalId'))), format('Monitoring Metrics Publisher + Monitoring Contributor granted on the DCR to principal {0}', parameters('principalId')), '(no principalId supplied - assign both roles on the DCR yourself)')]",
        "docs": "https://docs.abstractsecurity.app/docs/integrations/destination-integrations/azure-sentinel-destination/"
      }
    }
  }
}