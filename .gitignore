# Secrets — never commit (the demo's .env.example documents this assumption)
.env
*.env
!*.env.example
.abstract.env
.abstract/
*.key
*.pem
credentials

# Local artifacts that may contain tenant data
docs/threat-model/demo/*.local.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# OS / editor
# .vscode holds machine-specific paths (absolute home directories, local extension
# versions), so it is per-developer state rather than project content.
.vscode/
.idea/
.DS_Store
Thumbs.db

# demo export artifacts (generated by selftests / console authoring)
docs/threat-model/demo/parser_okta.json
docs/threat-model/demo/mitre_layer.json

# Jupyter checkpoints
docs/threat-model/demo/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# AI-assistant instruction files are generated per machine by the Claude operating
# system (~/.claude/dist/vscode-sync/sync.py). They carry internal notes and local
# paths, so they stay local and are never published from this public repository.
AGENTS.md
.github/copilot-instructions.md
.cursor/
