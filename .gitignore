# Secrets — never commit (the demo's .env.example documents this assumption)
.env
*.env
!*.env.example
.abstract.env
.abstract/
*.key
*.pem
credentials

# Local artifacts that may contain tenant data
*.local.*

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# OS / editor
# .vscode holds machine-specific paths (absolute home directories, local extension
# versions), so it is per-developer state rather than project content.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter checkpoints
**/.ipynb_checkpoints/

# Per-machine AI-assistant and editor-tool state. It can carry local paths and notes,
# so it stays local and is never published from this public repository.
AGENTS.md
.github/copilot-instructions.md
.cursor/
.claude/
.remember/
:memory:*

# Local copy of the SOC demo, which moved out of this repository (see tag archive/pre-cleanup-2026-09-28)
docs/threat-model/
